# ---------------------------------------------------------------------------
# Generated COM output — 1.1 GB, rebuilt by any run. Never commit.
# ---------------------------------------------------------------------------
results/

# ---------------------------------------------------------------------------
# Python / test caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Report assets regenerated by R (plotly/htmlwidgets JS, ~4 MB per report dir).
# The .html reports themselves ARE tracked; only their asset cache is ignored.
# ---------------------------------------------------------------------------
**/lib/
*.pdf.tmp

# Stray console captures
stdoutC.txt
stderrC.txt

# Office/LibreOffice lock files left behind while a document is open
.~lock.*#

# Machine-local Claude Code state (settings.json IS shared; these are not)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/

# ---------------------------------------------------------------------------
# Channel data — 210 MB of Touchstone files from the public IEEE 802.3dj
# contribution akinwale_3dj_elec_01_2310. Excluded to keep the repo small and
# fast to clone; anyone with the contribution can drop the folder back in.
# To ship the data with the repo instead, delete the next line.
# ---------------------------------------------------------------------------
akinwale_3dj_01_2310/

# ---------------------------------------------------------------------------
# Vendor / third-party inputs — REVIEW BEFORE SHARING.
# These carry vendor or package identifiers and may not be yours to publish.
# Remove a line only once you have confirmed you can distribute that file.
# ---------------------------------------------------------------------------
*VendorX*.s4p
config_com_dj_200G_CAKR_178_PKGA_*.xlsx

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
*.swp

# ---------------------------------------------------------------------------
# Prompts based on emails from Hansel
# ---------------------------------------------------------------------------
Test_cases_from_Hansel_2026_08_12.txt

# ---------------------------------------------------------------------------
# Status reports
# ---------------------------------------------------------------------------
status_reports/

# ---------------------------------------------------------------------------
# MATLAB-comparison run artifacts (regenerable)
#   per-case job/log/result JSON for all 208 cases; rebuild with
#   `python tools/matlab_compare.py --validate --run`
# ---------------------------------------------------------------------------
matlab_compare_results/

benchmarks/
report_data/compare_prefix_opt.csv

# ---------------------------------------------------------------------------
# Redundant channel archives — every member of these four zips is ALSO tracked,
# already extracted, in the sibling directory next to each one. Tracking both
# put 71 MB of duplicate payload in every checkout.
#
# NOT ignored, because they are the only copy of their contents in the repo:
#   2_Intel/akinwale_3dj_01_2310.zip   (extraction is gitignored, see above)
#   0_Intel/akinwale_3dj_02_2311.zip   (only 12 of 24 members tracked elsewhere)
#
# Note this does not shrink an existing clone: the blobs remain in history, and
# only a history rewrite would remove them.
# ---------------------------------------------------------------------------
tests/0_IEEE_802p3dj_PublicArea_CR_KR_Channels/1_Arista/weaver_3dj_02_2311.zip
tests/0_IEEE_802p3dj_PublicArea_CR_KR_Channels/3_Intel_Molex/lim_3dj_07_2309.zip
tests/0_IEEE_802p3dj_PublicArea_CR_KR_Channels/4_Intel_TEConnectivity/lim_3dj_04_230629.zip
tests/0_IEEE_802p3dj_PublicArea_CR_KR_Channels/5_Intel_Amphenol/lim_3dj_03_230629.zip

# ---------------------------------------------------------------------------
# Correlation inputs — kept LOCAL, never published (2026-08-24)
#
# The port is open source; the data it was correlated against is not ours to
# redistribute. All of it is obtainable from the IEEE 802.3 public areas or from
# the contributions named in README.md and COM_Python_Tutorial.docx, so a
# reader can reproduce the correlation without us shipping 400 MB of it.
#
# Channel S-parameters (IEEE 802.3dj public-area contributions)
tests/0_IEEE_802p3dj_PublicArea_CR_KR_Channels/
# COM configuration workbooks
tests/1_IEEE_802p3dj_COM_Spreadsheets/
tests/1_IEEE_802p3dj_COM_Spreadsheets_fullgrid/
# MATLAB reference result workbooks
tests/2_Results_COM_Matlab/
# Config workbooks anywhere -- per-user test inputs, not ours to publish.
# Deliberately NOT a blanket *.xlsx: com_python_results/ holds the exported
# result workbooks, which are our own output and carry no third-party data.
config*.xlsx
# ---------------------------------------------------------------------------
# Development scaffolding -- prompts and state ledgers used while building the
# port. Useful provenance locally, noise in a published repo.
dev/prompts/
