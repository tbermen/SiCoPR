# ---------------------------------------------------------------------------
# Generated COM output — 1.1 GB, rebuilt by any run. Never commit.
# ---------------------------------------------------------------------------
results/

# ---------------------------------------------------------------------------
# Python / test caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Report assets regenerated by R (plotly/htmlwidgets JS, ~4 MB per report dir).
# The .html reports themselves ARE tracked; only their asset cache is ignored.
# ---------------------------------------------------------------------------
**/lib/
*.pdf.tmp

# Stray console captures
stdoutC.txt
stderrC.txt

# Office/LibreOffice lock files left behind while a document is open
.~lock.*#

# Machine-local Claude Code state (settings.json IS shared; these are not)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/

# ---------------------------------------------------------------------------
# Channel data — 210 MB of Touchstone files from the public IEEE 802.3dj
# contribution akinwale_3dj_elec_01_2310. Excluded to keep the repo small and
# fast to clone; anyone with the contribution can drop the folder back in.
# To ship the data with the repo instead, delete the next line.
# ---------------------------------------------------------------------------
akinwale_3dj_01_2310/

# ---------------------------------------------------------------------------
# Vendor / third-party inputs — REVIEW BEFORE SHARING.
# These carry vendor or package identifiers and may not be yours to publish.
# Remove a line only once you have confirmed you can distribute that file.
# ---------------------------------------------------------------------------
*VendorX*.s4p
config_com_dj_200G_CAKR_178_PKGA_*.xlsx

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
*.swp
