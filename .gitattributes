# Normalise line endings so collaborators on different platforms do not see
# spurious whole-file diffs. Without this, a Windows checkout stores CRLF and
# every text file appears rewritten to anyone on Linux or macOS.
#
# Text is stored LF in the repository and checked out native.
* text=auto

# Shell scripts and R must stay LF even on Windows: a CRLF shebang line makes
# the script unrunnable, and Rscript is fussy about stray carriage returns.
*.sh   text eol=lf
*.R    text eol=lf

# Checksum files are consumed by sha256sum, which treats a trailing CR as part
# of the filename and then fails to open every entry.
*.sha256 text eol=lf

# Binary deliverables: never diff or convert these.
*.pptx binary
*.docx binary
*.xlsx binary
*.png  binary
*.mat  binary
*.s4p  binary
